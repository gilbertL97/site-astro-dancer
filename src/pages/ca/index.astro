---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import ContactForm from '../../components/ContactForm.astro';
import Hero from '../../components/Hero.astro';
import Marquee from '../../components/Marquee.astro';
import { getLocaleUrl, useTranslations } from '../../i18n/utils';

const t = useTranslations('ca');
---

<BaseLayout
  locale="ca"
  title={`${t.siteName} — ${t.tagline}`}
  description={t.metaDescription}
  breadcrumbs={[{ name: t.nav.home, url: getLocaleUrl('ca', 'home') }]}
>
  <Hero
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    subtitle={t.hero.subtitle}
    primaryCta={{ label: t.workshop.cta, href: '#contact' }}
    secondaryCta={{ label: t.about.title, href: '#bio' }}
  />
  <Marquee items={t.marquee} label={t.dances.title} />
  <section aria-labelledby="bio">
    <div class="container">
      <div class="stack">
        <h2 id="bio">{t.about.title}</h2>
        {t.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>
  <section aria-labelledby="estilos">
    <div class="container">
      <div class="stack">
        <h2 id="estilos">{t.dances.title}</h2>
        <div class="grid">
          {
            t.dances.items.map((dance) => (
              <Card title={dance} badge={dance.charAt(0)} />
            ))
          }
        </div>
      </div>
    </div>
  </section>
  <section aria-labelledby="workshop">
    <div class="container">
      <div class="stack">
        <h2 id="workshop">{t.workshop.title}</h2>
        <p>{t.workshop.text}</p>
        <p>
          <a href="#contact">{t.workshop.cta}</a>
        </p>
      </div>
    </div>
  </section>
  <section aria-labelledby="tutoriales">
    <div class="container">
      <div class="stack">
        <h2 id="tutoriales">{t.tutorials.title}</h2>
        <div class="grid">
          {
            t.tutorials.items.map((item) => (
              <Card title={item.title} badge={item.title.charAt(0)} />
            ))
          }
        </div>
      </div>
    </div>
  </section>
  <ContactForm locale="ca" />
</BaseLayout>
