---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocaleUrl, useTranslations } from '../../i18n/utils';

const t = useTranslations('ca');
---

<BaseLayout
  locale="ca"
  title={`${t.siteName} — ${t.tagline}`}
  description={t.hero.subtitle}
  breadcrumbs={[{ name: t.nav.home, url: getLocaleUrl('ca', 'home') }]}
>
  <div class="container">
    <div class="stack">
      <p>{t.hero.eyebrow}</p>
      <h1>{t.hero.title}</h1>
      <p>{t.hero.subtitle}</p>
    </div>
  </div>
</BaseLayout>
