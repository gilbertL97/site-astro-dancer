---
import BaseLayout from '../layouts/BaseLayout.astro';

// La 404 se sirve en español con enlaces a los tres inicios.
// No está en el mapa de rutas: no genera hreflang y lleva noindex.
const title = 'Página no encontrada — Oscar';
const description =
  'La página que buscas no existe o ha cambiado de dirección.';
---

<BaseLayout locale="es" title={title} description={description} noindex>
  <div class="container">
    <div class="stack">
      <p>404</p>
      <h1>Página no encontrada</h1>
      <p>{description}</p>
      <ul class="flow">
        <li>
          <a href="/">Inicio</a>
        </li>
        <li>
          <a href="/ca/" lang="ca" hreflang="ca">Inici</a>
        </li>
        <li>
          <a href="/en/" lang="en" hreflang="en">Home</a>
        </li>
      </ul>
    </div>
  </div>
</BaseLayout>
