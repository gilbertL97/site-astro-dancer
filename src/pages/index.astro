---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('es');
---

<BaseLayout
  locale="es"
  title={`${t.siteName} — ${t.tagline}`}
  description={t.hero.subtitle}
>
  <div class="container">
    <div class="stack">
      <p>{t.hero.eyebrow}</p>
      <h1>{t.hero.title}</h1>
      <p>{t.hero.subtitle}</p>
    </div>
  </div>
</BaseLayout>
