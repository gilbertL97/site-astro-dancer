---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLocaleUrl, useTranslations } from '../../i18n/utils';

const t = useTranslations('en');
const title = `${t.legal.privacy} — ${t.siteName}`;
---

<BaseLayout
  locale="en"
  title={title}
  description={title}
  breadcrumbs={[
    { name: t.nav.home, url: getLocaleUrl('en', 'home') },
    { name: t.legal.privacy, url: getLocaleUrl('en', 'privacy') },
  ]}
>
  <div class="container">
    <div class="stack">
      <h1>{t.legal.privacy}</h1>
      <!-- TODO(Diseño): texto legal definitivo. -->
      <p>{t.pendingCopy}</p>
    </div>
  </div>
</BaseLayout>
