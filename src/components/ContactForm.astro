---
import type { Locale } from '../i18n/routing';
import { useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
  id?: string;
}

const { locale, id = 'contact' } = Astro.props;
const t = useTranslations(locale);
const titleId = `${id}-title`;
---

<!-- TODO(Diseño): conectar a un servicio externo (endpoint + Turnstile).
     Estructura y honeypot listos; sin JavaScript. -->
<section aria-labelledby={titleId} class="contact">
  <div class="container">
    <div class="stack">
      <h2 id={titleId}>{t.form.title}</h2>
      <form class="form" action="#" method="post">
        <div class="stack">
          <p class="form__field">
            <label class="form__label" for={`${id}-name`}>{t.form.name}</label>
            <input
              class="form__input"
              id={`${id}-name`}
              name="name"
              type="text"
              autocomplete="name"
              required
            />
          </p>
          <p class="form__field">
            <label class="form__label" for={`${id}-email`}>{t.form.email}</label
            >
            <input
              class="form__input"
              id={`${id}-email`}
              name="email"
              type="email"
              autocomplete="email"
              required
            />
          </p>
          <p class="form__field">
            <label class="form__label" for={`${id}-message`}>
              {t.form.message}
            </label>
            <textarea
              class="form__input"
              id={`${id}-message`}
              name="message"
              rows="5"
              required></textarea>
          </p>
          <p class="visually-hidden" aria-hidden="true">
            <label>
              {t.form.honeypot}
              <input
                type="text"
                name="company"
                tabindex="-1"
                autocomplete="off"
              />
            </label>
          </p>
          <p class="form__field">
            <button class="form__submit" type="submit">{t.form.send}</button>
          </p>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  @layer components {
    .contact {
      padding-block: var(--space-2xl);
    }

    .form__label {
      display: block;
      margin-block-end: var(--space-xs);
      font-weight: var(--font-weight-medium);
    }

    .form__input {
      width: 100%;
      padding: var(--space-sm);
      color: var(--color-text);
      background-color: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
    }

    .form__submit {
      min-height: var(--size-touch);
      padding-inline: var(--space-lg);
      font-weight: var(--font-weight-semibold);
      color: var(--color-on-primary);
      cursor: pointer;
      background-color: var(--color-primary);
      border: 1px solid var(--color-primary);
      border-radius: var(--radius-md);
    }
  }
</style>
