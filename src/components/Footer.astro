---
import type { Locale } from '../i18n/routing';
import { getLocaleUrl, useTranslations } from '../i18n/utils';

interface Props {
  currentLocale: Locale;
}

const { currentLocale } = Astro.props;
const t = useTranslations(currentLocale);
const year = new Date().getFullYear();
---

<!-- TODO(Diseño): estructura temporal; el diseño definitivo la sustituirá. -->
<footer class="footer">
  <div class="container stack">
    <nav aria-label={t.footer.legalLabel} class="footer__legal">
      <a href={getLocaleUrl(currentLocale, 'privacy')}>{t.legal.privacy}</a>
      <a href={getLocaleUrl(currentLocale, 'cookies')}>{t.legal.cookies}</a>
      <a href={getLocaleUrl(currentLocale, 'legal')}>{t.legal.notice}</a>
    </nav>
    <p class="footer__rights">
      © {year}
      {t.siteName}. {t.footer.rights}
    </p>
  </div>
</footer>

<style>
  @layer components {
    .footer {
      margin-block-start: var(--space-2xl);
      padding-block: var(--space-xl);
      border-block-start: 1px solid var(--color-border);
    }

    .footer__legal {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-sm) var(--space-md);
    }

    .footer__rights {
      font-size: var(--text-sm);
      color: var(--color-text-muted);
    }
  }
</style>
