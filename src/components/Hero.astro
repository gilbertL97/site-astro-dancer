---
interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const { eyebrow, title, subtitle, primaryCta, secondaryCta } = Astro.props;
---

<!-- TODO(Diseño): foto del hero pendiente; al llegar, el título usará
     máscara de recorte fotográfica como en el mockup editorial. -->
<section class="hero">
  <div class="container">
    <div class="stack">
      <p class="hero__eyebrow">{eyebrow}</p>
      <h1 class="hero__title">{title}</h1>
      <p class="hero__subtitle">{subtitle}</p>
      {
        (primaryCta || secondaryCta) && (
          <p class="hero__actions">
            {primaryCta && (
              <a class="hero__cta hero__cta--primary" href={primaryCta.href}>
                {primaryCta.label}
              </a>
            )}
            {secondaryCta && (
              <a class="hero__cta hero__cta--ghost" href={secondaryCta.href}>
                {secondaryCta.label}
              </a>
            )}
          </p>
        )
      }
      <slot />
    </div>
  </div>
</section>

<style>
  @layer components {
    .hero {
      padding-block: var(--space-3xl);
    }

    .hero__eyebrow {
      display: inline-flex;
      align-items: center;
      align-self: flex-start;
      gap: var(--space-sm);
      padding: var(--space-xs) var(--space-md);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--color-text);
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
    }

    .hero__eyebrow::before {
      width: 0.5em;
      height: 0.5em;
      content: '';
      background-color: var(--color-primary);
      border-radius: var(--radius-pill);
    }

    .hero__title {
      font-size: var(--text-5xl);
      font-weight: var(--font-weight-extrabold);
      text-transform: uppercase;
    }

    .hero__subtitle {
      max-width: 40rem;
      font-family: var(--font-display);
      font-size: var(--text-2xl);
      font-weight: var(--font-weight-extrabold);
      text-transform: uppercase;
      background-image: linear-gradient(
        120deg,
        var(--color-primary),
        var(--color-accent)
      );
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
    }

    .hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-sm) var(--space-md);
    }

    .hero__cta {
      display: inline-flex;
      align-items: center;
      min-height: var(--size-touch);
      padding-inline: var(--space-lg);
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      font-weight: var(--font-weight-semibold);
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      text-decoration: none;
      border-radius: var(--radius-sm);
    }

    .hero__cta--primary {
      color: var(--color-on-primary);
      background-color: var(--color-primary);
      border: 1px solid var(--color-primary);
    }

    .hero__cta--primary:hover {
      box-shadow: var(--shadow-glow);
    }

    .hero__cta--ghost {
      color: var(--color-text);
      background-color: transparent;
      border: 1px solid var(--color-border);
    }

    .hero__cta--ghost:hover {
      border-color: var(--color-primary);
    }
  }
</style>
