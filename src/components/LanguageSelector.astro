---
import { locales, type Locale } from '../i18n/routing';
import { getEquivalentUrl, useTranslations } from '../i18n/utils';

interface Props {
  currentLocale: Locale;
  currentPath: string;
}

const { currentLocale, currentPath } = Astro.props;
const t = useTranslations(currentLocale);

// Iniciales ISO del idioma: funcionan igual en los tres idiomas
// y evitan el problema de las banderas emoji.
const CODES: Record<Locale, string> = { es: 'ES', ca: 'CA', en: 'EN' };
const selectId = 'language-select';
---

<form class="language-selector" data-language-selector action="#">
  <label class="visually-hidden" for={selectId}>
    {t.languageSelectorLabel}
  </label>
  <select id={selectId} class="language-selector__select" autocomplete="off">
    {
      locales.map((locale) => (
        <option
          value={getEquivalentUrl(currentPath, currentLocale, locale)}
          selected={locale === currentLocale}
          lang={locale}
        >
          {CODES[locale]}
        </option>
      ))
    }
  </select>
  <noscript>
    <ul class="language-selector__list">
      {
        locales.map((locale) => (
          <li>
            <a
              class="language-selector__link"
              href={getEquivalentUrl(currentPath, currentLocale, locale)}
              hreflang={locale}
              lang={locale}
              aria-current={locale === currentLocale ? 'page' : undefined}
              data-active={locale === currentLocale}
            >
              {t.languageNames[locale]}
            </a>
          </li>
        ))
      }
    </ul>
  </noscript>
</form>

<script>
  // TODO(Seguridad/Fase 8): al endurecer la CSP, añadir el hash de este script.
  // Navegación del <select>: sin JS el formulario no puede navegar,
  // por eso existe el <noscript> con enlaces equivalentes.
  const select = document.getElementById('language-select');
  if (select instanceof HTMLSelectElement) {
    select.addEventListener('change', () => {
      if (select.value) {
        window.location.assign(select.value);
      }
    });
  }
</script>

<style>
  @layer components {
    .language-selector {
      display: inline-flex;
      align-items: center;
    }

    .language-selector__select {
      min-height: var(--size-touch);
      padding-inline: var(--space-sm);
      font-size: var(--text-sm);
      color: var(--color-text);
      cursor: pointer;
      background-color: var(--color-bg-muted);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-pill);
    }

    .language-selector__list {
      display: flex;
      flex-wrap: wrap;
      margin: 0;
      padding: 0;
      list-style: none;
      gap: var(--space-xs);
    }

    .language-selector__link {
      display: inline-flex;
      align-items: center;
      min-height: var(--size-touch);
      padding-inline: var(--space-sm);
      font-size: var(--text-sm);
      color: var(--color-text-muted);
      border: 1px solid transparent;
      border-radius: var(--radius-pill);
    }

    .language-selector__link[data-active='true'] {
      font-weight: var(--font-weight-bold);
      color: var(--color-text);
      text-decoration: none;
      border-color: var(--color-primary);
    }
  }
</style>
